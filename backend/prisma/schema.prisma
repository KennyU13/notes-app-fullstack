generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Utilisateur {
  id           String      @id @default(uuid())
  email        String      @unique
  motDePasse   String
  prenom       String
  nom          String
  refreshToken String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  notes        Note[]
  categories   Categorie[]
  tags         Tag[]
}

model Note {
  id            String      @id @default(uuid())
  titre         String
  contenu       String
  estFavorite   Boolean     @default(false)
  estArchivee   Boolean     @default(false)
  estEpinglee   Boolean     @default(false)
  estSupprimee  Boolean     @default(false)
  supprimeeAt   DateTime?
  couleur       String      @default("#8b5cf6")
  utilisateurId String
  categorieId   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  categorie     Categorie?  @relation(fields: [categorieId], references: [id], onDelete: SetNull)
  tags          NoteTag[]

  @@index([utilisateurId])
  @@index([categorieId])
  @@index([estSupprimee])
  @@index([estEpinglee])
}

model Categorie {
  id            String      @id @default(uuid())
  nom           String
  couleur       String      @default("#6366f1")
  icone         String      @default("Folder")
  utilisateurId String
  createdAt     DateTime    @default(now())
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  notes         Note[]

  @@unique([nom, utilisateurId])
}

model Tag {
  id            String      @id @default(uuid())
  nom           String
  utilisateurId String
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  notes         NoteTag[]

  @@unique([nom, utilisateurId])
}

model NoteTag {
  noteId String
  tagId  String
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
}
